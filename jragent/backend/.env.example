# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quant_shop

# 鉴权
JWT_SECRET=change-me-to-a-long-random-string-please
JWT_EXPIRE_HOURS=168

# Xiaomi MiMo —— OpenAI 兼容协议
# 官方文档：https://mimo.mi.com/docs/zh-CN/quick-start/summary/first-api-call
# BASE_URL 按付费方式三选一：
#   按量付费（实时）  https://api.xiaomimimo.com/v1
#   批量推理         https://batch-api-cn.xiaomimimo.com/v1
#   Token Plan      https://token-plan-cn.xiaomimimo.com/v1  （key 形如 tp-xxx / ttp-xxx）
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_MODEL=mimo-v2.6-pro

# 运营
ADMIN_PHONE=13800000000
MERCHANT_QR_IMAGE=/static/pay-qr.png

# 假支付：mock=点按钮直接到账；qr=收款码+手动核销（演示推荐 qr）
PAY_MODE=qr

TZ=Asia/Shanghai

# 联网搜索（可选）—— 让 AI 能去网上找因子思路
# 不配也能用，只是 AI 只能靠模型记忆提因子，且会如实告诉你「没联网」
#
# 三个可选服务，选一个填：
#   tavily  专为 AI 设计，注册送免费额度，https://tavily.com
#   bocha   博查，国内公司，按次计费约 0.03 元/次，https://bochaai.com
#   serper  Google 结果，免费 2500 次，https://serper.dev
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
